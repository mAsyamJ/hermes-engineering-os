+def _strip_spawn_flag(argv: list, flag: str) -> list:
+    out = []
+    skip = False
+    for part in argv:
+        if skip:
+            skip = False
+            continue
+        if part == flag:
+            skip = True
+            continue
+        out.append(part)
+    return out
+
+
+_SPAWN_OVERRIDE_KEYS = frozenset({"model", "provider", "skills", "profile"})
+
+
+def _parse_spawn_overrides(item):
+    """Return a cleaned dict, None to skip, or False if invalid."""
+    if item is None or item == {} or item == "":
+        return None
+    if not isinstance(item, dict):
+        return False
+    if any(key not in _SPAWN_OVERRIDE_KEYS for key in item):
+        return False
+    cleaned = {}
+    if "model" in item:
+        value = item["model"]
+        if value in (None, "") or not isinstance(value, str):
+            return False
+        cleaned["model"] = value
+    if "provider" in item:
+        value = item["provider"]
+        if value in (None, "") or not isinstance(value, str):
+            return False
+        cleaned["provider"] = value
+    if "skills" in item:
+        skills = item["skills"]
+        if isinstance(skills, str):
+            skills = [skills]
+        if not isinstance(skills, (list, tuple)):
+            return False
+        names = []
+        for skill in skills:
+            if not isinstance(skill, str) or not skill or "/" in skill or "\\" in skill or "\x00" in skill:
+                return False
+            names.append(skill)
+        cleaned["skills"] = names
+    if "profile" in item:
+        value = item["profile"]
+        if value in (None, "") or not isinstance(value, str) or "/" in value or "\x00" in value:
+            return False
+        cleaned["profile"] = value
+    return cleaned
+
+
+def _merge_spawn_overrides(items: list):
+    """Merge agreeing SpawnOverrides. Conflict -> None (caller keeps baseline)."""
+    merged = {}
+    for item in items:
+        for key, value in item.items():
+            if key in merged and merged[key] != value:
+                return None
+            merged[key] = value
+    return merged
+
+
+def _apply_transform_kanban_worker_spawn(task, board, cmd, env, profile_arg):
+    """Honor optional transform_kanban_worker_spawn. Fail open to baseline.
+
+    Synchronous trusted-plugin invocation: a hung callback is NOT preempted.
+    Production Engineering OS must register only the OS-timeout IPC client.
+    """
+    try:
+        from hermes_cli.lifecycle import has_hook, invoke_hook
+    except Exception:
+        return cmd, env, profile_arg
+    try:
+        if not has_hook("transform_kanban_worker_spawn"):
+            return cmd, env, profile_arg
+    except Exception:
+        return cmd, env, profile_arg
+
+    snapshot = {
+        "task_id": getattr(task, "id", None),
+        "assignee": getattr(task, "assignee", None),
+        "board": board,
+        "skills": list(task.skills or []) if getattr(task, "skills", None) else [],
+        "model_override": getattr(task, "model_override", None),
+        "provider_override": getattr(task, "provider_override", None),
+    }
+    try:
+        results = invoke_hook(
+            "transform_kanban_worker_spawn",
+            task_id=snapshot["task_id"],
+            assignee=snapshot["assignee"],
+            board=board,
+            task_snapshot=dict(snapshot),
+        )
+    except Exception:
+        return cmd, env, profile_arg
+
+    parsed_items = []
+    for item in results or []:
+        parsed = _parse_spawn_overrides(item)
+        if parsed is False:
+            return cmd, env, profile_arg
+        if parsed:
+            parsed_items.append(parsed)
+    if not parsed_items:
+        return cmd, env, profile_arg
+    overrides = _merge_spawn_overrides(parsed_items)
+    if not overrides:
+        return cmd, env, profile_arg
+
+    cmd = list(cmd)
+    env = dict(env)
+    if "profile" in overrides:
+        try:
+            from hermes_cli.profiles import normalize_profile_name, resolve_profile_env
+
+            profile_arg = normalize_profile_name(str(overrides["profile"]))
+            cmd = _strip_spawn_flag(cmd, "-p")
+            if "--cli" in cmd:
+                idx = cmd.index("--cli")
+                cmd[idx:idx] = ["-p", profile_arg]
+            else:
+                cmd.extend(["-p", profile_arg])
+            try:
+                env["HERMES_HOME"] = resolve_profile_env(profile_arg)
+            except FileNotFoundError:
+                return list(cmd), dict(env), profile_arg
+            env["HERMES_PROFILE"] = profile_arg
+        except Exception:
+            return cmd, env, profile_arg
+    if "skills" in overrides:
+        cmd = _strip_spawn_flag(cmd, "--skills")
+        for skill in overrides["skills"]:
+            cmd.extend(["--skills", skill])
+    if "model" in overrides:
+        cmd = _strip_spawn_flag(cmd, "-m")
+        cmd.extend(["-m", overrides["model"]])
+    if "provider" in overrides:
+        cmd = _strip_spawn_flag(cmd, "--provider")
+        cmd.extend(["--provider", overrides["provider"]])
+    return cmd, env, profile_arg
+
+
