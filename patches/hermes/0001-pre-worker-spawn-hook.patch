diff --git a/tests/hermes_cli/test_pre_worker_spawn.py b/tests/hermes_cli/test_pre_worker_spawn.py
new file mode 100644
index 0000000..b28fb78
--- /dev/null
+++ b/tests/hermes_cli/test_pre_worker_spawn.py
@@ -0,0 +1,68 @@
+from __future__ import annotations
+
+import subprocess
+
+
+def _make_task(kb, *, assignee: str):
+    return kb.Task(
+        id="t_spawn_pre",
+        title="spawn pre",
+        body=None,
+        assignee=assignee,
+        status="running",
+        priority=0,
+        created_by="test",
+        created_at=1,
+        started_at=None,
+        completed_at=None,
+        workspace_kind="dir",
+        workspace_path=None,
+        claim_lock="lock",
+        claim_expires=None,
+        tenant=None,
+        current_run_id=7,
+    )
+
+
+def _capture_spawn(monkeypatch, tmp_path, hook):
+    root = tmp_path / ".hermes"
+    profile = root / "profiles" / "elias"
+    profile.mkdir(parents=True)
+    profile.joinpath("config.yaml").write_text("toolsets:\n  - hermes-cli\n", encoding="utf-8")
+    root.joinpath("config.yaml").write_text("toolsets:\n  - kanban\n", encoding="utf-8")
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    from hermes_cli import kanban_db as kb
+
+    monkeypatch.setattr(kb, "_resolve_hermes_argv", lambda: ["hermes"])
+    captured = {}
+
+    class FakeProc:
+        pid = 4242
+
+    def fake_popen(cmd, *args, **kwargs):
+        captured["cmd"] = list(cmd)
+        captured["env"] = dict(kwargs.get("env") or {})
+        return FakeProc()
+
+    monkeypatch.setattr(subprocess, "Popen", fake_popen)
+    monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", hook)
+    workspace = tmp_path / "workspace"
+    workspace.mkdir()
+    task = _make_task(kb, assignee="elias")
+    kb._default_spawn(task, str(workspace), board="test")
+    return captured
+
+
+def test_pre_worker_spawn_can_override_model(monkeypatch, tmp_path):
+    captured = _capture_spawn(monkeypatch, tmp_path, lambda *a, **k: [{"model": "gpt-test", "provider": "openai-codex"}])
+    assert "-m" in captured["cmd"]
+    assert "gpt-test" in captured["cmd"]
+    assert "--provider" in captured["cmd"]
+
+
+def test_pre_worker_spawn_exception_keeps_baseline(monkeypatch, tmp_path):
+    def boom(*a, **k):
+        raise RuntimeError("hook failed")
+
+    captured = _capture_spawn(monkeypatch, tmp_path, boom)
+    assert "-m" not in captured["cmd"]
