+def _apply_pre_worker_spawn(task: Task, board: Optional[str], cmd: list, env: dict, profile_arg: str):
+    """Honor optional pre_worker_spawn overrides. Fail closed to baseline."""
+    from concurrent.futures import ThreadPoolExecutor
+
+    snapshot = {
+        "task_id": getattr(task, "id", None),
+        "assignee": getattr(task, "assignee", None),
+        "board": board,
+        "skills": list(task.skills or []) if getattr(task, "skills", None) else [],
+        "model_override": getattr(task, "model_override", None),
+        "provider_override": getattr(task, "provider_override", None),
+    }
+    try:
+        from hermes_cli.lifecycle import invoke_hook
+
+        with ThreadPoolExecutor(max_workers=1) as pool:
+            future = pool.submit(
+                invoke_hook,
+                "pre_worker_spawn",
+                task_id=snapshot["task_id"],
+                assignee=snapshot["assignee"],
+                board=board,
+                task_snapshot=dict(snapshot),
+            )
+            results = future.result(timeout=0.05)
+    except Exception:
+        return cmd, env, profile_arg
+    overrides: dict = {}
+    for item in results or []:
+        if isinstance(item, dict):
+            overrides.update(item)
+        elif item is not None:
+            return cmd, env, profile_arg
+    allowed = {"model", "provider", "skills", "profile"}
+    if any(key not in allowed for key in overrides):
+        return cmd, env, profile_arg
+    if not overrides:
+        return cmd, env, profile_arg
+
+    def _strip_flag(argv: list, flag: str) -> list:
+        out = []
+        skip = False
+        for part in argv:
+            if skip:
+                skip = False
+                continue
+            if part == flag:
+                skip = True
+                continue
+            out.append(part)
+        return out
+
+    if "profile" in overrides and overrides["profile"]:
+        profile_arg = str(overrides["profile"])
+        cmd = _strip_flag(cmd, "-p")
+        if "--cli" in cmd:
+            idx = cmd.index("--cli")
+            cmd[idx:idx] = ["-p", profile_arg]
+        else:
+            cmd.extend(["-p", profile_arg])
+        try:
+            from hermes_cli.profiles import resolve_profile_env
+
+            env["HERMES_HOME"] = resolve_profile_env(profile_arg)
+        except Exception:
+            pass
+        env["HERMES_PROFILE"] = profile_arg
+    if "skills" in overrides:
+        cmd = _strip_flag(cmd, "--skills")
+        skills = overrides["skills"]
+        if isinstance(skills, str):
+            skills = [skills]
+        for skill in skills or []:
+            if skill:
+                cmd.extend(["--skills", str(skill)])
+    if "model" in overrides:
+        cmd = _strip_flag(cmd, "-m")
+        if overrides["model"]:
+            cmd.extend(["-m", str(overrides["model"])])
+    if "provider" in overrides:
+        cmd = _strip_flag(cmd, "--provider")
+        if overrides["provider"]:
+            cmd.extend(["--provider", str(overrides["provider"])])
+    return cmd, env, profile_arg
+
+
 def _default_spawn(
     task: Task,
     workspace: str,
@@ -10184,6 +10270,7 @@ def _default_spawn(
         # turn, prints text, exits rc=0, and the dispatcher records a
