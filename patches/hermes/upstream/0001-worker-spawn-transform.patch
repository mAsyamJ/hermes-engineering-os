+def test_multiple_callback_agree_applies(monkeypatch, tmp_path):
+    captured = _capture_spawn(
+        monkeypatch,
+        tmp_path,
+        lambda *a, **k: [{"model": "gpt-5.6-terra"}, {"model": "gpt-5.6-terra", "provider": "openai-codex"}],
+    )
+    assert captured["cmd"][captured["cmd"].index("-m") + 1] == "gpt-5.6-terra"
