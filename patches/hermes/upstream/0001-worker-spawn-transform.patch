+def test_observer_still_fires_after_transform(tmp_path, all_assignees_spawnable, monkeypatch):
+    home = tmp_path / ".hermes"
+    home.mkdir()
+    monkeypatch.setenv("HERMES_HOME", str(home))
+    monkeypatch.setenv("HERMES_KANBAN_CRASH_GRACE_SECONDS", "0")
+    monkeypatch.setattr(Path, "home", lambda: tmp_path)
+    from hermes_cli import kanban_db as kb
+
+    kb.init_db()
+
+    events = []
+    mgr = get_plugin_manager()
+    saved = {k: list(v) for k, v in mgr._hooks.items()}
+    mgr._hooks.setdefault("transform_kanban_worker_spawn", []).append(
+        lambda **kw: {"model": "gpt-observer"}
+    )
+    mgr._hooks.setdefault("on_kanban_worker_spawned", []).append(lambda **kw: events.append(kw))
+    try:
+        conn = kb.connect()
+        try:
+            tid = kb.create_task(conn, title="t", assignee="alice")
+            result = kb.dispatch_once(conn, spawn_fn=lambda *a, **k: 7777)
+            assert any(row[0] == tid for row in result.spawned)
+            row = conn.execute("SELECT worker_pid FROM tasks WHERE id = ?", (tid,)).fetchone()
+            assert row[0] == 7777
+        finally:
+            conn.close()
+        assert len(events) == 1
+        assert events[0]["worker_pid"] == 7777
+        assert events[0]["task_id"] == tid
+    finally:
+        mgr._hooks = saved
