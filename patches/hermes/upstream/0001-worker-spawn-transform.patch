+def test_no_kanban_write(monkeypatch, tmp_path):
+    from hermes_cli import kanban_db as kb
+
+    captured = _capture_spawn(monkeypatch, tmp_path, lambda *a, **k: [{"model": "gpt-x"}])
+    kb.init_db()
+    conn = kb.connect()
+    try:
+        tid = kb.create_task(conn, title="immutable", assignee="elias")
+        before = conn.execute(
+            "SELECT id, title, assignee, status, model_override, provider_override, skills FROM tasks WHERE id = ?",
+            (tid,),
+        ).fetchone()
+        kb._default_spawn(
+            _make_task(kb, assignee="elias", id="t_spawn_tx2"),
+            captured["workspace"],
+            board="test",
+        )
+        after = conn.execute(
+            "SELECT id, title, assignee, status, model_override, provider_override, skills FROM tasks WHERE id = ?",
+            (tid,),
+        ).fetchone()
+        assert after == before
+    finally:
+        conn.close()
+
+
