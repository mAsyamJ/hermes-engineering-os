+from __future__ import annotations
+
+import subprocess
+import time
+
+from pathlib import Path
+
+from hermes_cli.plugins import VALID_HOOKS, get_plugin_manager
+
+
+def _make_task(kb, *, assignee: str, **overrides):
+    fields = dict(
+        id="t_spawn_tx",
+        title="spawn transform",
+        body=None,
+        assignee=assignee,
+        status="running",
+        priority=0,
+        created_by="test",
+        created_at=1,
+        started_at=None,
+        completed_at=None,
+        workspace_kind="dir",
+        workspace_path=None,
+        claim_lock="lock",
+        claim_expires=None,
+        tenant=None,
+        current_run_id=7,
+    )
+    fields.update(overrides)
+    return kb.Task(**fields)
+
+
+def _capture_spawn(monkeypatch, tmp_path, hook, **task_kw):
+    root = tmp_path / ".hermes"
+    profile = root / "profiles" / "elias"
+    profile.mkdir(parents=True)
+    profile.joinpath("config.yaml").write_text("toolsets:\n  - hermes-cli\n", encoding="utf-8")
+    other = root / "profiles" / "other"
+    other.mkdir(parents=True)
+    other.joinpath("config.yaml").write_text("toolsets:\n  - hermes-cli\n", encoding="utf-8")
+    root.joinpath("config.yaml").write_text("toolsets:\n  - kanban\n", encoding="utf-8")
+    monkeypatch.setenv("HERMES_HOME", str(root))
+    from hermes_cli import kanban_db as kb
+
+    monkeypatch.setattr(kb, "_resolve_hermes_argv", lambda: ["hermes"])
+    captured = {}
+
+    class FakeProc:
+        pid = 4242
+
+    def fake_popen(cmd, *args, **kwargs):
+        captured["cmd"] = list(cmd)
+        captured["env"] = dict(kwargs.get("env") or {})
+        return FakeProc()
+
+    monkeypatch.setattr(subprocess, "Popen", fake_popen)
+    if hook is not None:
+        monkeypatch.setattr("hermes_cli.lifecycle.invoke_hook", hook)
+        monkeypatch.setattr("hermes_cli.lifecycle.has_hook", lambda name: name == "transform_kanban_worker_spawn")
+    else:
+        monkeypatch.setattr("hermes_cli.lifecycle.has_hook", lambda name: False)
+    workspace = tmp_path / "workspace"
+    workspace.mkdir()
+    task = _make_task(kb, assignee="elias", **task_kw)
+    pid = kb._default_spawn(task, str(workspace), board="test")
+    captured["pid"] = pid
+    captured["workspace"] = str(workspace)
+    return captured
+
+
+def test_hook_is_registered():
+    assert "transform_kanban_worker_spawn" in VALID_HOOKS
+    assert "on_kanban_worker_spawned" in VALID_HOOKS
+
+
+def test_no_subscriber_baseline_argv_unchanged(monkeypatch, tmp_path):
+    captured = _capture_spawn(monkeypatch, tmp_path, None)
+    assert captured["cmd"][:6] == ["hermes", "-p", "elias", "--cli", "--accept-hooks", "chat"] or (
+        captured["cmd"][0] == "hermes" and "-p" in captured["cmd"] and "-m" not in captured["cmd"]
+    )
+    assert "-m" not in captured["cmd"]
+    assert "--provider" not in captured["cmd"]
+    assert captured["pid"] == 4242
+
+
