[Unit]
Description=Hermes EOS protected adaptation actuator (SO_PEERCRED)
After=network-online.target
Requires=hermes-eos-actuator.socket

[Service]
Type=simple
User=hermes-actuator
Group=hermes-runtime
ExecStart=/usr/lib/hermes-runtime/venv/bin/python -m engineering_os.adaptation.actuator
Environment=PYTHONPATH=/usr/local/lib/hermes-eos:/usr/lib/hermes-runtime/hermes-agent
Environment=HERMES_EOS_ACTUATOR_SOCK=/run/hermes-eos/actuator.sock
Environment=HERMES_EOS_RESERVE_SQLITE=/var/lib/hermes-actuator/reservations.sqlite
Environment=EOS_ADAPTATION_RUNTIME=/var/lib/hermes-actuator/adaptation
EnvironmentFile=-/etc/hermes-eos/actuator.env
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=hermes-eos
RuntimeDirectoryMode=0750
ReadWritePaths=/var/lib/hermes-actuator /run/hermes-eos

[Install]
WantedBy=multi-user.target
