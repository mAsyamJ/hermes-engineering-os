[Unit]
Description=Hermes Agent Gateway rp-friend (hermes-runtime, same-SHA, no spawn-transform at H1)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=hermes-runtime
Group=hermes-runtime
ExecStart=/usr/lib/hermes-runtime/venv/bin/python -m hermes_cli.main --profile rp-friend gateway run
WorkingDirectory=/var/lib/hermes-runtime/home/profiles/rp-friend
Environment=HERMES_HOME=/var/lib/hermes-runtime/home/profiles/rp-friend
Environment=HERMES_EOS_ACTUATOR_SOCK=/run/hermes-eos/actuator.sock
Environment=PATH=/usr/lib/hermes-runtime/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
Environment=VIRTUAL_ENV=/usr/lib/hermes-runtime/venv
Restart=always
RestartSec=5
RestartForceExitStatus=75
RestartPreventExitStatus=78
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
TimeoutStopSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
